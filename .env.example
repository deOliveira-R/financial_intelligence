# Copy to .env and fill in.
FI_DATABASE_URL=sqlite:///data/fin_intel.db
# SEC requires a descriptive User-Agent with contact email: "Your Name you@example.com"
FI_SEC_USER_AGENT=
# https://fred.stlouisfed.org/docs/api/api_key.html
FI_FRED_API_KEY=
# https://www.tiingo.com/account/api/token
FI_TIINGO_API_KEY=
# Where raw provider responses are kept (content-addressed, gzip). Never delete casually:
# `fin-intel rebuild` reconstructs every table from it.
FI_RAW_DIR=data/raw
