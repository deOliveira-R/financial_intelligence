# Copy to .env and fill in. The app reads FI_* settings (src/fin_intel/config.py); on the
# server, compose.yaml also reads the container settings at the end. Keep .env out of git.

# --- data source keys (all free) ---
# SEC requires a descriptive User-Agent with contact email: "Your Name you@example.com"
FI_SEC_USER_AGENT=
# https://fred.stlouisfed.org/docs/api/api_key.html
FI_FRED_API_KEY=
# https://www.tiingo.com/account/api/token
FI_TIINGO_API_KEY=
# https://massive.com/dashboard/api-keys (free Basic plan)
FI_MASSIVE_API_KEY=
# Optional. https://www.eia.gov/opendata/register.php (the default DEMO_KEY is rate-limited)
FI_EIA_API_KEY=DEMO_KEY
# Optional: home-market filings for companies without US listings (free registration).
# https://api.edinet-fsa.go.jp (Japan) and https://opendart.fss.or.kr (Korea)
FI_EDINET_API_KEY=
FI_OPENDART_API_KEY=
# Optional. https://www.openfigi.com/api (raises CUSIP-mapping limits ~100x)
FI_OPENFIGI_API_KEY=
# Optional but needed for lobbying history. https://lda.gov/api/register
FI_LDA_API_KEY=
# Optional. https://api.congress.gov/sign-up/ (bills come from GovInfo bulk files without it)
FI_CONGRESS_API_KEY=
# Optional: conflict events (ACLED). Your acleddata.com account; the API trades it for a token.
FI_ACLED_EMAIL=
FI_ACLED_PASSWORD=

# --- what the scheduled syncs follow ---
# Tickers for Tiingo history + SEC fundamentals; FRED series (empty: the curated macro pack).
FI_WATCHLIST=AAPL,MSFT,NVDA,SPY
FI_FRED_SERIES=
FI_MARKET_OTC=true

# --- running outside containers (laptop) ---
# PostgreSQL URL (default: local socket as the OS user). Compose sets both in containers.
FI_DATABASE_URL=postgresql+psycopg://localhost:5433/fin_intel_dev
# Raw provider responses (content-addressed, gzip). Never delete casually: `fin-intel
# rebuild` reconstructs every table from it.
FI_RAW_DIR=data/raw

# --- server (see deploy/README.md) ---
# Require this value in the X-API-Key header on every endpoint but /health.
FI_API_KEY=
# rclone remote for deploy/backup.sh, e.g. oci:fin-intel-backups
FI_BACKUP_REMOTE=
# FI_BACKUP_KEEP_DAYS=30         # essential-table dumps kept
# FI_BACKUP_DB_SNAPSHOT=0        # 1: also a full pg_dump nightly (tens of GB)

# --- containers (compose.yaml); commented values are the defaults ---
# The app's database password (required): openssl rand -hex 24
FI_PG_PASSWORD=
# Host paths and owners
# FI_PG_DATA=./data/postgres     # database directory on the host
# PG_UID=999                     # its owner (999: the image's postgres user)
# PG_GID=999
# APP_UID=1002                   # owner of data/raw (the server's finintel user)
# APP_GID=1002
# RCLONE_CONFIG_DIR=~/.config/rclone
# API address on the host (Tailscale serve proxies to it)
# FI_API_BIND=127.0.0.1
# FI_API_PORT=8000
# Schedule, UTC, cron syntax; empty turns a job off. These mark steps due; the
# reconciler runs them and retries failures with backoff until they succeed.
# FI_SCHEDULE_DAILY=30 23 * * 1-5
# FI_SCHEDULE_WEEKLY=0 6 * * 0
# FI_SCHEDULE_NEWS=17 * * * *    # one GDELT query, the one refreshed longest ago
# FI_SCHEDULE_BACKUP=0 4 * * *
# FI_SCHEDULE_RECONCILE=*/10 * * * *
# Memory: limits per service (0 = none; the cron limit also bounds one-off jobs)
# FI_API_MEMORY=1g
# FI_CRON_MEMORY=6g
# PG_MEMORY=0
# PostgreSQL memory, sized for the 12 GB VM
# PG_SHARED_BUFFERS=2GB
# PG_EFFECTIVE_CACHE_SIZE=7GB
# PG_WORK_MEM=64MB
# PG_MAINTENANCE_WORK_MEM=1GB
# PG_MAX_WAL_SIZE=8GB
# PG_SHM_SIZE=1g
# PostgreSQL image, pinned by digest (change deliberately: a new major needs pg_upgrade)
# FI_PG_IMAGE=postgres:16.15-trixie@sha256:ca0bd484cb98bf4b24eb1010e73fb3fcbd6714d240fbc1a10eea5b7dbecb641d
